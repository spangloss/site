---
// Chart 3: the scenario calls each labeler answered sec.data_class secrets, as one
// stacked bar per labeler: real secrets, test-config calls, and other close calls.
// Segments are the labeler's color at three steps, split by a 2px gap, each with a
// direct label: inside when it fits, past the bar's end for a short last segment.
import { marker, type Results, type SecretsRow } from '../../lib/results';
import SeriesKey from './SeriesKey.astro';

interface Props {
  results: Results;
}
const { results } = Astro.props;

const SET = 'scenarios';
const setName = results.gold_sets.find((s) => s.id === SET)?.name;
type Scored = Extract<SecretsRow, { status: 'scored' }>;
const rows = results.models.map((m) => {
  const row = results.secrets_flagged.find((r) => r.set === SET && r.model === m.id);
  if (!row || row.status !== 'scored') throw new Error(`SecretsChart: no ${SET} secrets row for ${m.id}`);
  return { model: m, row: row as Scored };
});

const SEGMENTS = [
  { key: 'real', text: 'real', step: 'bar__fill', label: 'real secret', what: 'real secrets' },
  { key: 'test_config', text: 'test-config', step: 'bar__mid', label: 'test-config', what: 'test-config calls' },
  { key: 'other', text: 'other', step: 'bar__rest', label: 'other', what: 'other close calls' },
] as const;
const INSIDE_MIN = 3; // a segment this many calls wide fits its label at any width

const max = Math.max(...rows.map((r) => r.row.flagged));
const pc = (v: number) => `${(v / max) * 100}%`;
const BAR = 22;
const H = 30;
const y = (H - BAR) / 2;

const segments = (row: Scored) => {
  let start = 0;
  const parts = SEGMENTS.map((s) => {
    const n = row[s.key];
    const part = { ...s, n, start };
    start += n;
    return part;
  }).filter((p) => p.n > 0);
  return parts.map((p, i) => ({ ...p, last: i === parts.length - 1, first: i === 0 }));
};
---

<figure class="chart chart--secrets" aria-label={`Calls answered secrets in the ${setName} set, by what they were`}>
  <div class="chart__legend">
    {rows.map(({ model }) => <SeriesKey model={model.id} shape={marker(model.id)} text={`${model.name} (${model.runs})`} />)}
    {
      SEGMENTS.map((s) => (
        <span class="chart__key">
          <svg class="mark mark--neutral" width="16" height="12" aria-hidden="true">
            <rect class={s.step} x="0" y="1" width="16" height="10" />
          </svg>
          {s.label}
        </span>
      ))
    }
  </div>
  <div class="stack">
    {
      rows.map(({ model, row }) => (
        <>
          <span class="stack__label">
            <SeriesKey model={model.id} shape={marker(model.id)} text={model.name} />
            <span class="stack__total">{row.flagged} flagged</span>
          </span>
          <div class="stack__plot">
            <svg class="stack__track" height={H} role="group" aria-label={`${model.name}: ${row.flagged} calls answered secrets`}>
              {segments(row).map((s) => (
                <g class={`mark mark--${model.id}`}>
                  <title>{`${model.name}: ${s.n} of the ${row.flagged} calls it answered secrets were ${s.what}`}</title>
                  {/* The last segment's data end is rounded; its square cap overlaps it, so the
                      pair is faded as one group */}
                  <g class={s.step}>
                    <rect x={pc(s.start)} y={y} width={pc(s.n)} height={BAR} rx={s.last ? 4 : 0} />
                    {s.last && <rect x={pc(s.start)} y={y} width="6" height={BAR} />}
                  </g>
                  {!s.first && <rect class="bar__gap" x={pc(s.start)} y={y} width="2" height={BAR} />}
                  {s.n >= INSIDE_MIN ? (
                    <text class:list={['stack__in', { 'stack__in--dark': s.step !== 'bar__fill' }]} x={pc(s.start)} dx="9" y={H / 2 + 4}>
                      <tspan class="stack__long">{`${s.n} ${s.text}`}</tspan>
                      <tspan class="stack__short">{s.n}</tspan>
                    </text>
                  ) : (
                    s.last && (
                      <text class="chart__value" x={pc(s.start + s.n)} dx="8" y={H / 2 + 4}>
                        {`${s.n} ${s.text}`}
                      </text>
                    )
                  )}
                </g>
              ))}
            </svg>
          </div>
        </>
      ))
    }
  </div>
</figure>
