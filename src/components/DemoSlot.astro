---
import AsciinemaPlayer from './AsciinemaPlayer.astro';

/**
 * The landing page's demo. Renders nothing until it is given a recording:
 * add the file to public/casts/ and pass its name as `cast`.
 */
interface Props {
  cast?: string;
}

const { cast } = Astro.props;
---

{
  cast && (
    <section class="demo" aria-labelledby="demo-h">
      <h2 id="demo-h" class="visually-hidden">Demo</h2>
      <AsciinemaPlayer src={cast} title="spangloss labeling an agent session" />
    </section>
  )
}
