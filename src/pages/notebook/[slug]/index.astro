---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { formatDate, getEntries, getListing, type Entry } from '../../../lib/notebook';

export const getStaticPaths = (async () => {
  const entries = await getEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { number, title, dek, date, status, linkedin_url } = entry.data;

// The next number in the listing: a link if it has a page, else plain text.
const next = (await getListing()).find((row) => row.number > number);
---

<Base
  title={`Notebook No. ${number} · ${title}`}
  description={dek}
  ogImage={`/og/notebook/${entry.id}.png`}
  ogType="article"
  publishedTime={date}
  current="notebook"
  reading
>
  <article class="entry">
    <p class="entry__meta">
      <a href="/notebook/">NOTEBOOK</a>
      <span>NO. {number}</span>
      <span>{date ? formatDate(date) : '[DATE]'}</span>
      {status === 'draft' && <span class="draft-flag">DRAFT</span>}
    </p>
    <h1 class="ink">{title}</h1>
    <p class="entry__dek">{dek}</p>
    <p class="entry__byline">
      Phil DiCorpo{linkedin_url && <> · <a href={linkedin_url}>Short version on LinkedIn ↗</a></>}
    </p>

    <div class="prose">
      <Content />
    </div>

    <nav class="entry-nav" aria-label="Notebook">
      <a href="/notebook/">← All notebook entries</a>
      {next?.href && <a href={next.href}>Next: {next.title} →</a>}
      {next && !next.href && <span class="entry-nav__pending">Next: {next.title}</span>}
    </nav>
  </article>
</Base>
